<Window x:Class="MusicVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MusicVisualizer.UI.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Music Visualizer" Height="720" Width="1280"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="2" Margin="10" Padding="10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Добавить в очередь" Click="OpenFile_Click" Margin="0,0,10,0"/>
                <Button Content="Play" Click="Play_Click" IsEnabled="{Binding CanPlay}" Margin="0,0,5,0"/>
                <Button Content="Pause" Click="Pause_Click" IsEnabled="{Binding CanPlay}" Margin="0,0,5,0"/>
                <Button Content="Stop" Click="Stop_Click" IsEnabled="{Binding CanPlay}" Margin="0,0,15,0"/>
                <ComboBox x:Name="ModeSelector" Width="220"
                          materialDesign:HintAssist.Hint="Режим визуализации"
                          SelectionChanged="ModeSelector_SelectionChanged"
                          Margin="0,0,10,0"/>
                <Button x:Name="LoopButton" Content="Цикл: Выкл" Click="LoopButton_Click"
        Padding="16,8" MinWidth="120" Margin="0,0,5,0"/>
                <Button x:Name="ShuffleButton" Content="Перемешать: Выкл" Click="ShuffleButton_Click"
        Padding="16,8" MinWidth="150" Margin="0,0,0,0"/>
            </WrapPanel>
        </materialDesign:Card>

        <controls:SkiaVisualizerControl x:Name="VisualizerControl" Grid.Row="1" Grid.Column="0" Margin="10,0,0,0"/>

        <materialDesign:Card Grid.Row="1" Grid.Column="1" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Очередь" FontWeight="Bold" Margin="10"/>
                <ListBox x:Name="PlaylistList" Grid.Row="1"
                         ItemsSource="{Binding Playlist.Tracks}"
                         SelectedIndex="{Binding Playlist.CurrentIndex, Mode=OneWay}"
                         DisplayMemberPath="Name"
                         AllowDrop="True"
                         MouseDoubleClick="PlaylistList_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="PlaylistList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="PlaylistList_PreviewMouseMove"
                         DragOver="PlaylistList_DragOver"
                         Drop="PlaylistList_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="Background" Value="#5E35B1"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <WrapPanel Grid.Row="2" Margin="5">
                    <Button Content="Удалить" Click="RemoveTrack_Click" Margin="0,0,5,5"/>
                    <Button Content="Очистить" Click="ClearPlaylist_Click" Margin="0,0,5,5"/>
                    <Button Content="Сохранить" Click="SavePlaylist_Click" Margin="0,0,5,5"/>
                    <Button Content="Загрузить" Click="LoadPlaylist_Click" Margin="0,0,0,5"/>
                </WrapPanel>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="2" Grid.ColumnSpan="2" Margin="10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider x:Name="ProgressSlider"
        Grid.Column="1"
        Minimum="0" Maximum="1"
        VerticalAlignment="Center"
        IsMoveToPointEnabled="True"
        Focusable="False"
        ValueChanged="ProgressSlider_ValueChanged"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Громкость:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Slider x:Name="VolumeSlider" Width="150"
        Minimum="0" Maximum="1" Value="0.5"
        Focusable="False"
        ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>