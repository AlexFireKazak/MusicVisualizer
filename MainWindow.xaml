<Window x:Class="MusicVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicVisualizer"
        xmlns:controls="clr-namespace:MusicVisualizer.UI.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Music Visualizer" Height="720" Width="1280"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Открыть файл" Click="OpenFile_Click" Margin="0,0,10,0"/>
                <Button Content="Play" Click="Play_Click" Margin="0,0,5,0"/>
                <Button Content="Pause" Click="Pause_Click" Margin="0,0,5,0"/>
                <Button Content="Stop" Click="Stop_Click" Margin="0,0,15,0"/>

                <ComboBox x:Name="ModeSelector" 
                          Width="200" 
                          materialDesign:HintAssist.Hint="Режим визуализации"
                          SelectionChanged="ModeSelector_SelectionChanged"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Область визуализации -->
        <controls:SkiaVisualizerControl x:Name="VisualizerControl" Grid.Row="1" />

        <!-- Нижняя панель: прогресс и громкость -->
        <materialDesign:Card Grid.Row="2" Margin="10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Slider x:Name="ProgressSlider"
        Grid.Column="1"
        Minimum="0" Maximum="1"
        VerticalAlignment="Center"
        IsMoveToPointEnabled="True"
        ValueChanged="ProgressSlider_ValueChanged"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Громкость:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Slider x:Name="VolumeSlider" Width="150"
                    Minimum="0" Maximum="1" Value="0.5"
                    ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>