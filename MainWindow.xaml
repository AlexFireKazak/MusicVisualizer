<Window x:Class="MusicVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MusicVisualizer.UI.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Music Visualizer" Height="720" Width="1280"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFD54F"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="360" MinWidth="220" MaxWidth="600"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="3" Margin="10" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Добавить" Click="OpenFile_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,10,0"/>
                    <Button Click="PreviousTrack_Click" IsEnabled="{Binding CanPlay}"
                            Style="{StaticResource MaterialDesignIconButton}"                            
                            ToolTip="Предыдущий трек">
                        <materialDesign:PackIcon Kind="SkipPrevious" Width="22" Height="22"/>
                    </Button>
                    <Button Click="PlayPause_Click" IsEnabled="{Binding CanPlay}"
                            Style="{StaticResource MaterialDesignIconButton}"                            
                            ToolTip="Play/Pause (Space)">
                        <materialDesign:PackIcon Width="28" Height="28">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="Play"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Kind" Value="Pause"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>
                    <Button Click="Stop_Click" IsEnabled="{Binding CanPlay}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            
                            ToolTip="Стоп">
                        <materialDesign:PackIcon Kind="Stop" Width="22" Height="22"/>
                    </Button>
                    <Button Click="NextTrack_Click" IsEnabled="{Binding CanPlay}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Следующий трек">
                        <materialDesign:PackIcon Kind="SkipNext" Width="22" Height="22"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="LoopButton_Click"
                            Style="{StaticResource MaterialDesignIconButton}"                            
                            ToolTip="Режим цикла">
                        <materialDesign:PackIcon Width="20" Height="20">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="RepeatOff"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoopMode}" Value="All">
                                            <Setter Property="Kind" Value="Repeat"/>
                                            <Setter Property="Foreground" Value="#B39DDB"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LoopMode}" Value="One">
                                            <Setter Property="Kind" Value="RepeatOnce"/>
                                            <Setter Property="Foreground" Value="#B39DDB"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>
                    <Button Click="ShuffleButton_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Foreground="{StaticResource ButtonTextBrush}"
                            ToolTip="Перемешать">
                        <materialDesign:PackIcon Width="20" Height="20">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="ShuffleDisabled"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Shuffle}" Value="True">
                                            <Setter Property="Kind" Value="Shuffle"/>
                                            <Setter Property="Foreground" Value="#B39DDB"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>
                    <ComboBox x:Name="ModeSelector" Width="220"
                              materialDesign:HintAssist.Hint="Режим визуализации"
                              SelectionChanged="ModeSelector_SelectionChanged"
                              Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Визуализация -->
        <controls:SkiaVisualizerControl x:Name="VisualizerControl"
                                         Grid.Row="1" Grid.Column="0" Margin="10,0,0,0"/>

        <!-- Разделитель -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <!-- Очередь -->
        <materialDesign:Card Grid.Row="1" Grid.Column="2" Margin="5,10,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Очередь" FontWeight="Bold" Margin="10,10,10,5"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="13*"/>
                        <ColumnDefinition Width="44*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="PlaylistList"
         ItemsSource="{Binding Playlist.Tracks}"
         SelectedIndex="{Binding Playlist.CurrentIndex, Mode=OneWay}"
         AllowDrop="True"
         Background="Transparent"
         BorderThickness="0"
         MouseDoubleClick="PlaylistList_MouseDoubleClick"
         PreviewMouseLeftButtonDown="PlaylistList_PreviewMouseLeftButtonDown"
         PreviewMouseRightButtonDown="PlaylistList_PreviewMouseRightButtonDown"
         PreviewMouseMove="PlaylistList_PreviewMouseMove"
         DragOver="PlaylistList_DragOver"
         Drop="PlaylistList_Drop" Grid.ColumnSpan="3" Margin="0,0,0,0">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Играть" Click="ContextPlay_Click"/>
                                <MenuItem Header="Удалить" Click="ContextDelete_Click"/>
                                <MenuItem Header="Показать в проводнике" Click="ContextShowInExplorer_Click"/>
                                <Separator/>
                                <MenuItem Header="Очистить очередь" Click="ClearPlaylist_Click"/>
                                <MenuItem Header="Сохранить плейлист…" Click="SavePlaylist_Click"/>
                                <MenuItem Header="Загрузить плейлист…" Click="LoadPlaylist_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="#5E35B1"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="Play"
                                         Width="12" Height="12"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                           Opacity="0.6" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Перетащите файлы сюда&#10;или нажмите «Добавить»"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               TextAlignment="Center" Opacity="0.4"
                               IsHitTestVisible="False" Grid.Column="1" Margin="77,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Playlist.Tracks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <WrapPanel Grid.Row="2" Margin="5">
                    <Button Content="Очистить" Click="ClearPlaylist_Click"
                            
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,5"/>
                    <Button Content="Сохранить" Click="SavePlaylist_Click"
                            
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,5"/>
                    <Button Content="Загрузить" Click="LoadPlaylist_Click"
                            
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,0,5"/>
                </WrapPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Нижняя панель -->
        <materialDesign:Card Grid.Row="2" Grid.ColumnSpan="3" Margin="10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Slider x:Name="ProgressSlider"
                        Grid.Column="1"
                        Minimum="0" Maximum="1"
                        VerticalAlignment="Center"
                        IsMoveToPointEnabled="True"
                        Focusable="False"
                        ValueChanged="ProgressSlider_ValueChanged"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="VolumeHigh" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Slider x:Name="VolumeSlider" Width="150"
                            Minimum="0" Maximum="1" Value="0.5"
                            Focusable="False"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>